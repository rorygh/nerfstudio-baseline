FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

WORKDIR /opt/nerfstudio-baseline

# COLMAP via a standalone micromamba env (conda-forge), same pattern proven
# out in DynamicReconstruction's Dockerfile.runpod: Ubuntu 22.04's apt colmap
# is an incompatible v3.x build, and libfaiss must be pinned to 1.10.0 (newer
# conda-forge builds are ABI-incompatible with this colmap build). See
# https://github.com/rorygh/DynamicReconstruction/blob/main/docs/architecture.md
# for the full story. Wrapped as a script (not a plain symlink + global
# LD_LIBRARY_PATH) from the start this time -- DynamicReconstruction hit a
# real bug where a global LD_LIBRARY_PATH pointed sshd at conda's OpenSSL
# instead of the system one, breaking SSH host-key generation.
RUN curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xvj -C /usr/local/bin --strip-components=1 bin/micromamba && \
    micromamba create -y -p /opt/colmap-env -c conda-forge colmap=4.0.4 "libfaiss=1.10.0=cpu_openblas*" openimageio && \
    printf '#!/bin/bash\nexec env LD_LIBRARY_PATH="/opt/colmap-env/lib:$LD_LIBRARY_PATH" /opt/colmap-env/bin/colmap "$@"\n' > /usr/local/bin/colmap && \
    chmod +x /usr/local/bin/colmap

# ffmpeg for ns-process-data video input (not needed for the bonsai mission
# itself -- Mip-NeRF 360 ships as photos -- but cheap to include).
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*

# Copy source and install nerfstudio in editable mode. No tiny-cuda-nn here:
# it's only needed for NeRF methods (nerfacto/instant-ngp), not splatfacto,
# which is the only method this mission uses -- see MISSION.md.
#
# pyproject.toml's base deps are lower-bound-only (torch>=1.13.1,
# Pillow>=10.3.0), so a plain `pip install -e .` upgrades this base image's
# CUDA-matched torch to whatever's newest and breaks downstream: confirmed on
# a live pod (runpod/pytorch template, not this exact base image, but same
# failure mode applies here) it silently jumped torch to a build for a
# different CUDA major version, and separately, newer Pillow removed/changed
# the C-internals `pil_to_numpy` (nerfstudio/data/utils/data_utils.py) relies
# on. Freeze torch/vision/audio to whatever this base image already ships
# *before* installing, and pin Pillow to a version confirmed to still work.
RUN pip install --upgrade pip setuptools && \
    pip freeze | grep -E '^torch(vision|audio)?==' > /tmp/pinned-constraints.txt && \
    echo "Pillow==10.4.0" >> /tmp/pinned-constraints.txt && \
    pip install -e . -c /tmp/pinned-constraints.txt
RUN chmod +x runpod/run_bonsai.sh

# gsplat==1.4.0 (pyproject.toml pin) turned out to be a pure-Python wheel
# that JIT-compiles its CUDA kernels via torch's cpp_extension loader on
# first use, keyed off whatever torch is active then -- so the base image's
# torch/CUDA build matters at *train* time, not install time. Confirmed
# working end-to-end (JIT compile + full splatfacto training run) against
# torch 2.8.0+cu128 on an RTX 3090 pod; the exact torch/CUDA build in *this*
# base image is still unverified -- check the JIT-compile step (right after
# "Caching / undistorting train images") the first time you run
# runpod/run_bonsai.sh on a freshly built image.

# ns-viewer's websocket (Viser) port, for looking at results interactively
# instead of (or in addition to) runpod/run_bonsai.sh's static renders --
# expose this as a pod TCP port when deploying, or SSH-tunnel it.
EXPOSE 7007

# Base image's own start script (SSH/Jupyter bring-up) -- training itself is
# a manual `runpod/run_bonsai.sh` run over SSH, not part of container start,
# per MISSION.md's "one comparison, not a service" scope.
CMD ["/start.sh"]
